{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Askama extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode",
        "${workspaceFolder}/fixtures/sample-site"
      ],
      "outFiles": ["${workspaceFolder}/editors/vscode/out/**/*.js"],
      "preLaunchTask": "build extension"
    }
  ]
}
